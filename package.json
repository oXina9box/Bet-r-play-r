{
  "name": "bet-r-play-r",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "test:e2e": "node test/server.test.js && node test/browser.test.js",
    "audit:data": "node scripts/audit-data.js",
    "generate:tracker": "node scripts/generate-tracker.js",
    "sync:live": "node scripts/sync-live-results.js",
    "generate:tests": "node scripts/bet-tests/cli.js",
    "sync:tests": "node scripts/bet-tests/cli.js",
    "store:tests": "node scripts/bet-tests/cli.js --store",
    "test:betting": "node --test test/bet-tests-engine.test.js test/bet-tests-history.test.js test/bet-tests-workbook.test.js test/bet-tests-simple.test.js",
    "verify:tests": "node scripts/bet-tests/verify.js"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "^1.0.0",
    "tesseract.js": "^7.0.0",
